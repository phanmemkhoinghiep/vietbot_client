<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules.
   SharedPreferences that may contain tokens, MQTT credentials, or device IDs
   are EXCLUDED from cloud backup. Only non-sensitive UI preferences are kept.
   See https://developer.android.com/guide/topics/data/autobackup
   Note: This file is ignored for devices older than API 31
-->
<full-backup-content>
    <!-- Exclude vietbot_settings (may contain credentials + media history) -->
    <exclude domain="sharedpref" path="vietbot_settings.xml"/>
    <!-- Exclude app_prefs (Hilt-provided SharedPreferences) -->
    <exclude domain="sharedpref" path="app_prefs.xml"/>
</full-backup-content>