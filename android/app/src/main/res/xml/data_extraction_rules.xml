<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ data extraction rules.
   Exclude sensitive SharedPreferences from cloud backup (credentials, tokens).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="vietbot_settings.xml"/>
        <exclude domain="sharedpref" path="app_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="vietbot_settings.xml"/>
        <exclude domain="sharedpref" path="app_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>